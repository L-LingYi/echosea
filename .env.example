# Companion System v1.2 Environment Configuration
# Copy to .env and replace all secrets before deploying to production!

APP_PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL 17 + pgvector
POSTGRES_DB=companion
POSTGRES_USER=companion
POSTGRES_PASSWORD=change_me_pg_password
DATABASE_URL=postgresql+asyncpg://companion:change_me_pg_password@postgres:5432/companion

# Redis 7
REDIS_URL=redis://redis:6379/0

# Security (Generate strong random strings: openssl rand -base64 32)
MASTER_ENCRYPTION_KEY=change-me-generate-32-byte-random-master-key
JWT_SECRET_KEY=change-me-generate-32-byte-random-jwt-secret
JWT_EXPIRE_MINUTES=720
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=ChangeMeStrongPass2026!

# SnowLuma OneBot v11 Gateway Configuration
# Modes:
#   reverse_ws -> SnowLuma connects to ws://<your-server>:8000/ws/onebot/v11
#   forward_ws -> Companion connects to SnowLuma at SNOWLUMA_WS_URL
#   dual       -> Both enabled simultaneously
SNOWLUMA_MODE=reverse_ws
SNOWLUMA_WS_URL=ws://host.docker.internal:3001/
SNOWLUMA_HTTP_URL=http://host.docker.internal:3000
SNOWLUMA_ACCESS_TOKEN=change-me-snowluma-token
# Optional independent SnowLuma HTTP API token
SNOWLUMA_HTTP_ACCESS_TOKEN=
BOT_QQ=123456789
ADMIN_QQ=987654321

# Guardrails & Daily Budget Circuit Breaker
MAX_CONSECUTIVE_GROUP_TURNS=4
GROUP_RATE_LIMIT_PER_MINUTE=12
GLOBAL_RATE_LIMIT_PER_MINUTE=40
DAILY_BUDGET_USD=5.0
BUDGET_ALERT_RATIO=0.8
SOFT_ENTRY_THRESHOLD=0.78
AMBIENT_SUMMARY_TRIGGER_COUNT=20
DM_BRIDGE_WINDOW_MINUTES=30
PLUGIN_TIMEOUT_SECONDS=5.0

# Online Self-Update (Privilege-Separated Host Updater Daemon)
# Leave UPDATE_GITHUB_REPO empty during local repo stage; fill 'owner/repo' once public on GitHub.
UPDATE_GITHUB_REPO=
UPDATE_GIT_BRANCH=main
UPDATE_AGENT_URL=
UPDATE_WEBHOOK_SECRET=
