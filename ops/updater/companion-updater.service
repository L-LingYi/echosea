[Unit]
Description=Companion System host updater
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/var/lib/companion-updater
EnvironmentFile=/etc/companion-updater.env
Environment=DOCKER_CONFIG=/var/lib/companion-updater/docker-config
ExecStart=/usr/bin/python3 /usr/local/libexec/companion-updater/host_updater.py
StateDirectory=companion-updater
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/companion-system
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
